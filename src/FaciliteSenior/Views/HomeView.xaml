<UserControl x:Class="FaciliteSenior.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <UserControl.Resources>
    <Style x:Key="HomeTileButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryTileButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDanger}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HomeIconBadgeStyle" TargetType="Border" BasedOn="{StaticResource IconBadgeStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding BadgeKey}" Value="Accent">
          <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKey}" Value="Info">
          <Setter Property="Background" Value="{StaticResource InfoBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKey}" Value="Help">
          <Setter Property="Background" Value="{StaticResource HelpBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKey}" Value="Danger">
          <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource CardBorderStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 HorizontalAlignment="Center"
                 Style="{StaticResource PageTitleTextStyle}"
                 Text="Que voulez-vous faire ?"
                 TextAlignment="Center" />

      <TextBlock Grid.Row="1"
                 Margin="0,12,0,20"
                 HorizontalAlignment="Center"
                 Style="{StaticResource BodyTextStyle}"
                 Text="Tout se passe dans cette application. L'affichage s'adapte automatiquement aux petits ecrans."
                 TextAlignment="Center" />

      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Actions}"
                      HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding Command}"
                      Style="{StaticResource HomeTileButtonStyle}"
                      Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      MinHeight="{Binding DataContext.TileMinHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Padding="{Binding DataContext.TilePadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Margin="{Binding DataContext.TileMargin, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel VerticalAlignment="Center">
                  <Border Style="{StaticResource HomeIconBadgeStyle}"
                          HorizontalAlignment="Center"
                          Visibility="{Binding DataContext.ShowCardIcons, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="{Binding DataContext.IconFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding IconGlyph}" />
                  </Border>
                  <TextBlock Margin="0,14,0,6"
                             HorizontalAlignment="Center"
                             FontSize="{Binding DataContext.LabelFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             FontWeight="SemiBold"
                             Text="{Binding Label}"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             Visibility="{Binding DataContext.ShowCardLabels, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock HorizontalAlignment="Center"
                             Style="{StaticResource BodyTextStyle}"
                             FontSize="{Binding DataContext.DescriptionFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Text="{Binding Description}"
                             TextAlignment="Center"
                             Visibility="{Binding DataContext.ShowCardDescriptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>

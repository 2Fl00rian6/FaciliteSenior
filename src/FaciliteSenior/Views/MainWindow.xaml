<Window x:Class="FaciliteSenior.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FaciliteSenior.Views"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="860"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
  <!-- Le fond de la fenetre est transparent pour laisser apparaitre le vrai materiau Mica de
       Windows 11 (active en code-behind via DWM). Le contenu (barre laterale, cartes) reste
       opaque par-dessus, comme dans les applications Windows natives (Parametres, Courrier...). -->
  <Grid>
    <Grid.LayoutTransform>
      <ScaleTransform ScaleX="{Binding InterfaceScale}" ScaleY="{Binding InterfaceScale}" />
    </Grid.LayoutTransform>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Barre laterale de navigation, façon NavigationView Windows 11 (Courrier, Photos, Parametres). -->
    <Border Grid.Column="0"
            Width="240"
            Margin="12,12,0,12"
            Padding="0,16"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource CardShadowEffect}">
      <DockPanel LastChildFill="False">
        <!-- Marque de l'application -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,4,14,20">
          <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentBrush}">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="&#xE80F;" />
          </Border>
          <TextBlock VerticalAlignment="Center"
                     Margin="12,0,0,0"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     Text="{Binding WindowTitle}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- Bas de la barre laterale : plein ecran, aidant, quitter -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Border Height="1" Margin="14,0,14,10" Background="{DynamicResource BorderBrushSoft}" />

          <Button Command="{Binding ToggleFullScreenCommand}" Style="{StaticResource SidebarNavButtonStyle}" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Text="{Binding FullScreenIconGlyph}" Width="24" />
              <TextBlock Margin="12,0,0,0" Text="{Binding FullScreenLabel}" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSettingsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Text="&#xE713;" Width="24" />
              <TextBlock Margin="12,0,0,0" Text="Parametres aidant" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Command="{Binding ExitCommand}" Style="{StaticResource SidebarNavButtonStyle}" HorizontalAlignment="Stretch" Foreground="{DynamicResource DangerBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Text="&#xE8BB;" Width="24" />
              <TextBlock Margin="12,0,0,0" Text="Quitter" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Elements de navigation principaux -->
        <StackPanel DockPanel.Dock="Top">
          <Button Command="{Binding ShowHomeCommand}" HorizontalAlignment="Stretch">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsHomeSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Text="&#xE80F;" Width="24" />
              <TextBlock Margin="12,0,0,0" Text="Accueil" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Command="{Binding ShowDocumentsCommand}" HorizontalAlignment="Stretch">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDocumentsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Text="&#xE130;" Width="24" />
              <TextBlock Margin="12,0,0,0" Text="Documents" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Command="{Binding ShowHelpCommand}" HorizontalAlignment="Stretch">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsHelpSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Text="&#xE897;" Width="24" />
              <TextBlock Margin="12,0,0,0" Text="Aide" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Colonne de contenu : barre contextuelle + page active -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Margin="12,12,12,0"
              Padding="14,10"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrushSoft}"
              BorderThickness="1"
              CornerRadius="14"
              Effect="{StaticResource CardShadowEffect}">
        <WrapPanel Orientation="Horizontal">
          <Button Command="{Binding BackCommand}" Style="{StaticResource NavigationButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Text="&#xE72B;" />
              <TextBlock Margin="10,0,0,0" Text="Retour" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Command="{Binding RefreshCommand}" Style="{StaticResource NavigationButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Text="&#xE72C;" />
              <TextBlock Margin="10,0,0,0" Text="Actualiser" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Command="{Binding ClosePageCommand}" Style="{StaticResource NavigationButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Text="&#xE711;" />
              <TextBlock Margin="10,0,0,0" Text="Fermer la page" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </Border>

      <!-- Chaque page est recreee a chaque navigation (y compris le navigateur integre) : c'est la
           configuration stable confirmee sans probleme d'affichage. -->
      <ContentControl Grid.Row="1"
                      Margin="12,12,12,12"
                      Content="{Binding CurrentContent}" />
    </Grid>

    <!-- Fenetre modale "maison" : un voile + une carte au centre de la MEME fenetre, au lieu
         d'ouvrir une vraie fenetre Windows separee. Sert pour les confirmations, les messages
         et le code d'acces aidant. -->
    <Grid x:Name="ModalOverlay"
          Grid.Column="0"
          Grid.ColumnSpan="2"
          Background="#99000000"
          Visibility="Collapsed"
          Panel.ZIndex="1000"
          PreviewKeyDown="OnModalOverlayPreviewKeyDown">
      <Border MaxWidth="560"
              MinWidth="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="30"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrushSoft}"
              BorderThickness="1"
              CornerRadius="14"
              Effect="{StaticResource CardShadowEffect}">
        <StackPanel>
          <TextBlock x:Name="ModalTitleText" Style="{StaticResource SectionTitleTextStyle}" />
          <TextBlock x:Name="ModalMessageText"
                     Margin="0,16,0,4"
                     Style="{StaticResource BodyTextStyle}"
                     FontSize="20" />

          <StackPanel x:Name="ModalCodePanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Code" />
            <PasswordBox x:Name="ModalCodeBox"
                         Margin="0,8,0,0"
                         Padding="14,10"
                         FontSize="22"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource BorderBrushStrong}" />
          </StackPanel>

          <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ModalCancelButton" Click="OnModalCancelClick" Style="{StaticResource NavigationButtonStyle}">
              <TextBlock x:Name="ModalCancelText" />
            </Button>
            <Button x:Name="ModalConfirmButton" Click="OnModalConfirmClick" Style="{StaticResource PrimaryActionButtonStyle}">
              <TextBlock x:Name="ModalConfirmText" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

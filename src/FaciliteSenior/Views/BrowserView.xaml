<UserControl x:Class="FaciliteSenior.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Border Style="{StaticResource CardBorderStyle}" Padding="8">
    <Grid>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
        <wv2:WebView2 x:Name="BrowserControl"
                      AllowDrop="False"
                      Margin="2"
                      PreviewDragOver="OnBrowserPreviewDragOver"
                      PreviewDrop="OnBrowserPreviewDrop" />
      </Border>

      <Border Padding="26"
              Background="#F2F3F3F3"
              CornerRadius="8"
              Visibility="{Binding IsErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="28"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource CardShadowEffect}">
          <StackPanel Width="560">
            <TextBlock HorizontalAlignment="Center"
                       Style="{StaticResource SectionTitleTextStyle}"
                       Text="Impossible d'ouvrir cette page" />
            <TextBlock Margin="0,16,0,24"
                       Style="{StaticResource BodyTextStyle}"
                       Text="{Binding ErrorMessage}"
                       TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Command="{Binding RetryCommand}" Style="{StaticResource PrimaryActionButtonStyle}">
                <TextBlock Text="Reessayer" />
              </Button>
              <Button Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      Style="{StaticResource NavigationButtonStyle}">
                <TextBlock Text="Revenir a l'accueil" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>

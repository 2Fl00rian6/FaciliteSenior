<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Palette inspiree de Windows 11 (Fluent Design, theme clair, accent "Bleu Windows") -->
  <Color x:Key="WindowBackgroundColor">#FFF3F3F3</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceAltColor">#FFF7F7F7</Color>
  <Color x:Key="BorderColor">#FFE1E1E1</Color>
  <Color x:Key="BorderStrongColor">#FFC7C7C7</Color>

  <Color x:Key="AccentColor">#FF0067C0</Color>
  <Color x:Key="AccentLightColor">#FFE8F1FB</Color>
  <Color x:Key="AccentHoverColor">#FF1975C4</Color>
  <Color x:Key="AccentPressedColor">#FF004E8C</Color>

  <Color x:Key="PrimaryTextColor">#FF1B1B1B</Color>
  <Color x:Key="SecondaryTextColor">#FF5D5D5D</Color>

  <Color x:Key="DangerColor">#FFC42B1C</Color>
  <Color x:Key="DangerLightColor">#FFFDF3F2</Color>
  <Color x:Key="DangerBorderColor">#FFF1BBB3</Color>
  <Color x:Key="DangerPressedColor">#FFA4241A</Color>

  <Color x:Key="DisabledColor">#FFF3F3F3</Color>
  <Color x:Key="DisabledTextColor">#FFA0A0A0</Color>

  <!-- Couleurs de badge par categorie (icones des tuiles), inspirees des accents Windows 11 -->
  <Color x:Key="InfoColor">#FF6B4FBB</Color>
  <Color x:Key="HelpColor">#FF018574</Color>
  <Color x:Key="NeutralBadgeColor">#FF5D5D5D</Color>

  <Color x:Key="ShadowColor">#40000000</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderBrushStrong" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />

  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
  <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />

  <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="HelpBrush" Color="{StaticResource HelpColor}" />
  <SolidColorBrush x:Key="NeutralBadgeBrush" Color="{StaticResource NeutralBadgeColor}" />
</ResourceDictionary>
